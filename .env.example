# NetTwin Core configuration. Copy to .env and fill in the values.
# Generate random secrets with:  openssl rand -hex 32

# --- Required in production ---------------------------------------------------
# Signs session tokens. The server refuses to start in production when this is
# missing, shorter than 16 characters, or a placeholder.
JWT_SECRET=""

# --- First boot -----------------------------------------------------------------
# Password for the "admin" account created on first boot (ignored afterwards).
# Left empty in production, a random password is generated and printed once in
# the server log. In development the default is admin123.
ADMIN_PASSWORD=""

# --- HTTPS / reverse proxy ------------------------------------------------------
# Behind a reverse proxy that terminates TLS (nginx, Traefik, ...), set
# TRUST_PROXY=1 so the app sees the real client IP (login throttling) and marks
# the session cookie Secure automatically for HTTPS requests.
#TRUST_PROXY=1
# Force the session cookie's Secure flag on/off. Default: automatic (on for
# HTTPS requests). Only set "true" if users always reach the app over HTTPS.
#COOKIE_SECURE=true
# Port published by docker-compose (default 3000). With a reverse proxy on the
# same host, publish on loopback only so nobody can bypass the proxy (and spoof
# X-Forwarded-For):  APP_PORT=127.0.0.1:3000
#APP_PORT=3000
# Outside Docker: listen port / address of the Node server.
#PORT=3000
#HOST=0.0.0.0

# --- Database (MySQL) -----------------------------------------------------------
# docker-compose sets DB_HOST automatically. Outside Docker, leave DB_HOST unset
# to use JSON file storage in data/, or point it at your MySQL server.
DB_PASSWORD="change-this-db-password"
DB_ROOT_PASSWORD="change-this-root-password"
#DB_HOST="127.0.0.1"
#DB_PORT="3306"
#DB_USER="nettwin"
#DB_NAME="nettwin"

# --- SSH Sync (optional, read-only device collection) ---------------------------
# Both must be strong random values (16+ chars) to enable SSH Sync.
# CRED_KEY encrypts stored device passwords; changing it later makes the stored
# passwords unreadable (re-enter them in the SSH Sync menu).
CRED_KEY=""
# Shared secret between the app and the collector sidecar.
COLLECTOR_TOKEN=""
# Set automatically by docker-compose (http://collector:8000). Outside Docker,
# leave unset unless you run the collector yourself.
#COLLECTOR_URL="http://127.0.0.1:8000"
